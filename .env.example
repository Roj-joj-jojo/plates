# Leave unset for the local navigation-only shell.
# Add your own values to .env.local when backend setup is agreed.
# Never put a Supabase secret/service-role key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local deletion-record adapter only; keep account erasure disabled by default.
# Select private absolute paths outside the project and initialise them explicitly.
ACCOUNT_ERASURE_RECORDS_MODE=
LOCAL_ERASURE_RECORDS_FOLDER=
LOCAL_ERASURE_CHECKPOINTS_FOLDER=
LOCAL_ERASURE_KEY_PATH=
# ACCOUNT_ERASURE_ENABLED=true
# ACCOUNT_ERASURE_TEST_AUTH_ID=APPROVED_DISPOSABLE_AUTH_UUID
